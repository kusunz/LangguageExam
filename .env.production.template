# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# Production configuration template
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Core Server & Security
# -----------------------------------------------------------------------------
# Database (Neon Postgres)
DATABASE_URL=postgresql://user:***@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Security Secrets (generate with: openssl rand -hex 32)
ANSWER_HASH_SECRET=your-64-char-hex-secret-for-answer-hashing
WARMUP_SECRET=your-64-char-hex-secret-for-admin-cron-endpoints
DEMO_AUTH_SECRET=your-64-char-hex-secret-for-demo-sessions

# -----------------------------------------------------------------------------
# REQUIRED: Primary LLM Providers
# -----------------------------------------------------------------------------
# NVIDIA NIM (Primary for grading/explain/generate)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (Fallback provider & repair models)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPTIONAL: Secondary Providers (Embeddings & TTS)
# -----------------------------------------------------------------------------
# Gemini (Embeddings and text generation fallback)
GEMINI_API_KEY_A=your-gemini-api-key-a
# For high-availability embeddings, set a fallback key:
# GEMINI_API_KEY_B=your-gemini-api-key-b

# Deepgram (High-quality TTS voices)
DEEPGRAM_API_KEY=your-deepgram-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Server Config & Auth Mode
# -----------------------------------------------------------------------------
NODE_ENV=production
# In production, usually managed by PaaS (Vercel/Heroku/Railway)
# PORT=3000 
DB_MODE=neon

# Central Auth Validation
SESSION_INTROSPECT_URL=https://app.example.com/api/internal/session/introspect
DASUN_LOGIN_URL=https://app.example.com/login

# Production CORS
CORS_ORIGIN=https://your-production-domain.com

# -----------------------------------------------------------------------------

# Daily bank warmup (Vercel cron /api/admin/daily-bank/:level/:mode)
# DAILY_BANK_SET_COUNT=5
# DAILY_BANK_TARGET_PER_BUCKET=5
# DAILY_BANK_WARM_MAX_GENERATE_TOTAL=85
# OPENROUTER_DAILY_MAX=1000
# OPTIONAL: Advanced Tuning Overrides
# -----------------------------------------------------------------------------
# OPENROUTER_MODEL_GENERATE_PRIMARY=openai/gpt-oss-120b:free
# OPENROUTER_MODEL_REPAIR_PRIMARY=nvidia/nemotron-3-nano-30b-a3b:free
# NIM_MODEL_PRIMARY=openai/gpt-oss-120b

# DAILY_BANK_ENABLED=true
# DAILY_BANK_RETENTION_DAYS=30
# CURRENT_DAY_RARE_BUCKET_WARM_ENABLED=true