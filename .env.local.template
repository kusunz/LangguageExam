# =============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# =============================================================================
# Copy to server/.env for local development
# NEVER commit actual values to git
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Core Server & Security
# -----------------------------------------------------------------------------
# Database (Neon Postgres - use local dev branch or Neon proxy)
DATABASE_URL=postgresql://user:***@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# Security Secrets (generate with: openssl rand -hex 32)
ANSWER_HASH_SECRET=your-64-char-hex-secret-for-answer-hashing
WARMUP_SECRET=your-64-char-hex-secret-for-admin-cron-endpoints
DEMO_AUTH_SECRET=your-64-char-hex-secret-for-demo-sessions

# -----------------------------------------------------------------------------
# REQUIRED: Primary LLM Providers
# -----------------------------------------------------------------------------
# NVIDIA NIM (Primary for grading/explain/generate)
# Get key at: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (Fallback provider & repair models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPTIONAL: Secondary Providers (Embeddings & TTS)
# -----------------------------------------------------------------------------
# Gemini (Embeddings and text generation fallback)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY_A=your-gemini-api-key-a

# Deepgram (High-quality TTS voices)
# Get key at: https://console.deepgram.com/
# If omitted, system falls back to Gemini TTS or browser TTS
DEEPGRAM_API_KEY=your-deepgram-api-key

# -----------------------------------------------------------------------------
# OPTIONAL: Server Config & Modes
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
DB_MODE=auto

# Auth Mode:
# If SESSION_INTROSPECT_URL is commented out, server runs in DEMO MODE (guest auth)
# SESSION_INTROSPECT_URL=https://dasun.app/api/internal/session/introspect
# DASUN_LOGIN_URL=https://dasun.app/login
# DASUN_AUTHORIZE_URL=https://dasun.app/oauth/authorize
# OAUTH_TOKEN_URL=https://dasun.app/oauth/token
# OAUTH_SERVICE_TOKEN=admin-issued-secret-for-server-only
# OAUTH_CLIENT_ID=japanesePractice
# OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# INTERNAL_APP_KEY=japanesePractice
# INTERNAL_SERVICE_TOKEN=same-admin-issued-oauth-client-secret
# APP_SESSION_SECRET=replace-with-at-least-32-random-characters
# LOCAL_SESSION_COOKIE=jp_session
# LOCAL_SESSION_SECURE=false

# CORS (local dev - Vite proxy on :5173)
CORS_ORIGIN=http://localhost:5173


# Daily bank warmup (Vercel cron /api/admin/daily-bank/:level/:mode)
# DAILY_BANK_SET_COUNT=5
# DAILY_BANK_TARGET_PER_BUCKET=5
# DAILY_BANK_WARM_MAX_GENERATE_TOTAL=85
# OPENROUTER_DAILY_MAX=1000
# -----------------------------------------------------------------------------
# OPTIONAL: LLM Model Overrides
# Only set these if you want to override the default models in llm-router.js
# -----------------------------------------------------------------------------
# OPENROUTER_MODEL_GENERATE_PRIMARY=openai/gpt-oss-120b:free
# OPENROUTER_MODEL_REPAIR_PRIMARY=nvidia/nemotron-3-nano-30b-a3b:free
# NIM_MODEL_PRIMARY=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# OPTIONAL: Advanced Tuning (Defaults are usually fine)
# -----------------------------------------------------------------------------
# LLM_TIMEOUT_MS=120000
# BLUEPRINT_GENERATION_CONCURRENCY=4
# DAILY_BANK_ENABLED=true
# DAILY_BANK_SCHEDULE_HOUR=0
