# Server Environment Configuration
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname
DB_MODE=auto
DB_RUN_MIGRATIONS=0

# Central Auth Introspection
SESSION_INTROSPECT_URL=https://dasun.app/api/internal/session/introspect
DASUN_LOGIN_URL=https://dasun.app/login

# Demo session signing (recommended when Privy is enabled)
DEMO_AUTH_SECRET=your-long-random-demo-auth-secret

# Optional cross-origin allowlist for separate frontend origins
# Leave empty when frontend and backend are deployed on the same host
CORS_ORIGIN=
CORS_ORIGINS=

# OpenRouter LLM routing (PRIMARY - Nemotron free models with reasoning)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Generate (exam creation) - Quality priority chain
OPENROUTER_MODEL_GENERATE_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_GENERATE_SECONDARY=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_GENERATE_TERTIARY=nvidia/nemotron-3-nano-30b-a3b:free

# Repair (JSON fix) - Speed priority
OPENROUTER_MODEL_REPAIR_PRIMARY=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODEL_REPAIR_SECONDARY=openrouter/free

# Explain (grading/feedback) - Quality priority chain
OPENROUTER_MODEL_EXPLAIN_PRIMARY=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_EXPLAIN_SECONDARY=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_EXPLAIN_TERTIARY=nvidia/nemotron-3-nano-30b-a3b:free

OPENROUTER_GENERATE_REASONING_MAX_TOKENS=1024
LLM_GENERATE_MAX_TOKENS=16384
LLM_TIMEOUT_MS=120000
OPENROUTER_RPM=5
BLUEPRINT_GENERATION_CONCURRENCY=4
BLUEPRINT_EAGER_SLOT_COUNT=2
BLUEPRINT_ON_DEMAND_BATCH_SIZE=2
BLUEPRINT_ON_DEMAND_REQUEST_CONCURRENCY=2

# Gemini fallback text generation (SECONDARY - reliable json_object mode)
GEMINI_API_KEY_A=your-gemini-api-key-a
GEMINI_API_KEY_B=your-gemini-api-key-b
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK_COMPAT=

# Legacy Gemini compatibility
GEMINI_API_KEY=your-legacy-gemini-api-key

# Gemini embeddings (VECTOR(768))
GEMINI_EMBEDDING_KEY_A=your-gemini-embedding-key-a
GEMINI_EMBEDDING_KEY_B=your-gemini-embedding-key-b
GEMINI_EMBEDDING_MODEL_PRIMARY=gemini-embedding-001
GEMINI_EMBEDDING_MODEL_SECONDARY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_OUTPUT_DIM=768
EMBEDDING_BACKFILL_BATCH_SIZE=24
EMBEDDING_BATCH_MAX_ITEMS=6
EMBEDDING_BATCH_MAX_CHARS=24000

# TTS Providers (optional, browser TTS as fallback)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Default TTS mode: auto | gemini | deepgram | browser
DEFAULT_TTS_MODE=auto

# Warmup endpoint secret (admin access for cron jobs)
WARMUP_SECRET=your-secure-warmup-secret

# Security
ANSWER_HASH_SECRET=change-me-in-production
