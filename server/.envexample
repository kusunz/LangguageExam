# Server Environment Configuration
# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname
DB_MODE=auto
DB_RUN_MIGRATIONS=0

# Privy Auth (https://console.privy.io)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
PRIVY_CLIENT_ID=your-privy-client-id

# OpenRouter-first LLM routing
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL_GENERATE_PRIMARY=stepfun/step-3.5-flash:free
OPENROUTER_MODEL_GENERATE_SECONDARY=openai/gpt-oss-20b:free
OPENROUTER_MODEL_REPAIR_PRIMARY=openai/gpt-oss-20b:free
OPENROUTER_MODEL_REPAIR_SECONDARY=openai/gpt-oss-120b:free
OPENROUTER_MODEL_EXPLAIN_PRIMARY=openai/gpt-oss-20b:free
OPENROUTER_MODEL_EXPLAIN_SECONDARY=stepfun/step-3.5-flash:free

# Gemini fallback text generation
GEMINI_API_KEY_A=your-gemini-api-key-a
GEMINI_API_KEY_B=your-gemini-api-key-b
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite-preview
GEMINI_MODEL_FALLBACK_COMPAT=gemini-2.5-flash-lite

# Legacy Gemini compatibility
GEMINI_API_KEY=your-legacy-gemini-api-key

# Gemini embeddings (VECTOR(768))
GEMINI_EMBEDDING_KEY_A=your-gemini-embedding-key-a
GEMINI_EMBEDDING_KEY_B=your-gemini-embedding-key-b
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_OUTPUT_DIM=768

# TTS Providers (optional, browser TTS as fallback)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Default TTS mode: auto | gemini | deepgram | browser
DEFAULT_TTS_MODE=auto

# Warmup endpoint secret (admin access for cron jobs)
WARMUP_SECRET=your-secure-warmup-secret

# Security
ANSWER_HASH_SECRET=change-me-in-production
