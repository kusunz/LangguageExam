{
    "version": 2,
    "builds": [
        {
            "src": "server/server.js",
            "use": "@vercel/node"
        },
        {
            "src": "web/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/server/server.js"
        },
        {
            "src": "/exams/(.*)",
            "dest": "/web/dist/exams/$1"
        },
        {
            "src": "/(.*\\.(js|css|json|png|jpg|ico|woff|woff2))",
            "dest": "/web/dist/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/web/dist/index.html"
        }
    ]
}