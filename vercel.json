{
    "version": 2,
    "functions": {
        "api/index.js": {
            "includeFiles": "web/**",
            "maxDuration": 300
        }
    },
    "crons": [
        { "path": "/api/admin/warmup/N5/basic", "schedule": "5 0 * * *" },
        { "path": "/api/admin/warmup/N5/standard", "schedule": "10 0 * * *" },
        { "path": "/api/admin/warmup/N5/official", "schedule": "15 0 * * *" },
        { "path": "/api/admin/warmup/N4/basic", "schedule": "20 0 * * *" },
        { "path": "/api/admin/warmup/N4/standard", "schedule": "25 0 * * *" },
        { "path": "/api/admin/warmup/N4/official", "schedule": "30 0 * * *" },
        { "path": "/api/admin/warmup/N3/basic", "schedule": "35 0 * * *" },
        { "path": "/api/admin/warmup/N3/standard", "schedule": "40 0 * * *" },
        { "path": "/api/admin/warmup/N3/official", "schedule": "45 0 * * *" },
        { "path": "/api/admin/warmup/N2/basic", "schedule": "50 0 * * *" },
        { "path": "/api/admin/warmup/N2/standard", "schedule": "55 0 * * *" },
        { "path": "/api/admin/warmup/N2/official", "schedule": "0 1 * * *" },
        { "path": "/api/admin/warmup/N1/basic", "schedule": "5 1 * * *" },
        { "path": "/api/admin/warmup/N1/standard", "schedule": "10 1 * * *" },
        { "path": "/api/admin/warmup/N1/official", "schedule": "15 1 * * *" }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/api/index.js"
        }
    ]
}